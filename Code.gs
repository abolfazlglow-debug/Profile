const CONFIG={SPREADSHEET_ID:'1h5DSVWKD4vIb3NyVOP0WYo7oVXspWS08',SHEETS:{EXPERTS:'Experts',ARTICLES:'Articles',CATEGORIES:'Categories',PROJECTS:'Projects',SUBMISSIONS:'Submissions',SETTINGS:'Site_Settings'},MAX_MESSAGE:10000,MAX_NAME:150,MAX_EMAIL:254,RATE_SECONDS:60};
function doGet(e){try{const a=(e&&e.parameter&&e.parameter.action)||'health';if(a==='health')return out({success:true,status:'online',api:'AXVORQ',version:'1.1.0'});if(a==='articles')return out({success:true,data:rows('Articles').filter(r=>String(r.status).toLowerCase()==='published')});if(a==='experts')return out({success:true,data:rows('Experts').filter(r=>String(r.status).toLowerCase()==='published')});if(a==='projects')return out({success:true,data:rows('Projects').filter(r=>String(r.visibility).toLowerCase()==='public')});if(a==='categories')return out({success:true,data:rows('Categories').filter(r=>String(r.status).toLowerCase()==='active')});if(a==='settings')return out({success:true,data:rows('Site_Settings').filter(r=>String(r.is_public).toLowerCase()==='true')});if(a==='all')return out({success:true,data:{articles:rows('Articles').filter(r=>String(r.status).toLowerCase()==='published'),experts:rows('Experts').filter(r=>String(r.status).toLowerCase()==='published'),projects:rows('Projects').filter(r=>String(r.visibility).toLowerCase()==='public'),categories:rows('Categories').filter(r=>String(r.status).toLowerCase()==='active')}});return out({success:false,error:'UNKNOWN_ACTION'});}catch(err){return out({success:false,error:String(err.message||err)});}}
function doPost(e){const lock=LockService.getScriptLock();let response={success:false,error:'UNKNOWN_ERROR'};try{lock.waitLock(10000);const p=e&&e.parameter?e.parameter:{};const type=clean(p.submission_type||p.type);if(p.action!=='submit'||!['contact','expert','article','project','join'].includes(type))return respond(e,{success:false,error:'INVALID_REQUEST'});if(p.website)return respond(e,{success:false,error:'INVALID_SUBMISSION'});const name=clean(p.name,CONFIG.MAX_NAME),email=clean(p.email,CONFIG.MAX_EMAIL).toLowerCase(),message=clean(p.message,CONFIG.MAX_MESSAGE),role=clean(p.role_or_category||p.role||p.category,300),portfolio=clean(p.portfolio_url||p.portfolio,2000);if(!name||!/^\S+@\S+\.\S+$/.test(email)||!message)return respond(e,{success:false,error:'REQUIRED_FIELDS'});const cache=CacheService.getScriptCache(),key='submit_'+email;if(cache.get(key))return respond(e,{success:false,error:'RATE_LIMIT'});const sh=SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID).getSheetByName(CONFIG.SHEETS.SUBMISSIONS);if(!sh)throw new Error('Submissions sheet missing');const lastCol=sh.getLastColumn();if(lastCol<1)throw new Error('Submissions sheet headers missing');const headers=sh.getRange(1,1,1,lastCol).getValues()[0].map(String);const now=new Date().toISOString(),record={submission_id:'sub_'+Utilities.getUuid().replace(/-/g,'').slice(0,20),submission_type:type,name,email,role_or_category:role,portfolio_url:portfolio,message,status:'new',assigned_to:'',created_at:now,updated_at:now,internal_note:''};sh.appendRow(headers.map(h=>record[h]===undefined?'':sheetSafe(record[h])));cache.put(key,'1',CONFIG.RATE_SECONDS);response={success:true,message:'Submission received',submission_id:record.submission_id};return respond(e,response);}catch(err){response={success:false,error:String(err.message||err)};return respond(e,response);}finally{try{lock.releaseLock();}catch(_){}}}
function rows(name){const sh=SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID).getSheetByName(name);if(!sh)throw new Error('Sheet missing: '+name);const v=sh.getDataRange().getValues();if(v.length<2)return[];const h=v[0].map(x=>String(x).trim());return v.slice(1).filter(r=>r.some(x=>x!==''&&x!==null)).map(r=>{const o={};h.forEach((k,i)=>{if(k)o[k]=r[i] instanceof Date?r[i].toISOString():r[i];});return o;});}
function clean(v,n=2000){return String(v||'').replace(/[\u0000-\u0008\u000B\u000C\u000E-\u001F]/g,'').trim().slice(0,n);}
function sheetSafe(v){const s=String(v??'');return /^[\s]*[=+\-@]/.test(s)?'\''+s:s;}
function out(v){return ContentService.createTextOutput(JSON.stringify(v)).setMimeType(ContentService.MimeType.JSON);}
function respond(e,v){const p=e&&e.parameter?e.parameter:{};if(p.mode!=='iframe')return out(v);const nonce=clean(p.nonce,80).replace(/[^a-zA-Z0-9_-]/g,'');const data=JSON.stringify({type:'AXVORQ_SHEETS_RESULT',nonce,success:!!v.success,message:v.message||'',error:v.error||'',submission_id:v.submission_id||''}).replace(/</g,'\\u003c');const message=v.success?'ثبت انجام شد.':'ثبت ناموفق بود.';return HtmlService.createHtmlOutput('<!doctype html><meta charset="utf-8"><p>'+message+'</p><script>parent.postMessage('+data+',"*");</script>').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);}
function testConnection(){const ss=SpreadsheetApp.openById(CONFIG.SPREADSHEET_ID);Logger.log(ss.getName());ss.getSheets().forEach(s=>Logger.log(s.getName()+': '+s.getLastRow()+' rows / '+s.getLastColumn()+' cols'));}
